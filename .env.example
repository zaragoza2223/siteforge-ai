# Локальный Ollama с OpenAI-совместимым API
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

# Для другого OpenAI-совместимого провайдера замените URL, ключ и название модели.
# Пример для OpenAI: LLM_BASE_URL=https://api.openai.com/v1
# Не публикуйте настоящий API-ключ в GitHub.
